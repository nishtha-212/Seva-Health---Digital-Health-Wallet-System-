# PostgreSQL connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Long random string used to sign doctor login tokens
JWT_SECRET=change_this_to_a_long_random_string
# Optional: extra comma-separated origins allowed by CORS (only needed if frontend is hosted elsewhere)
CORS_ORIGINS=
PORT=3000
